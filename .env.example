# Appwrite configuration template — Yogava landing page
# ------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
#
# .env is gitignored; never commit real credentials.
# After changing values, regenerate the runtime config:
#     python _tools/sync-appwrite-env.py
#
# On hosting platforms (e.g. Render), set these as environment
# variables in the dashboard instead of committing .env.

# Appwrite Cloud endpoint (region: nyc | syd | fra | sfo)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Appwrite project ID (safe for the browser; used by the Web SDK)
APPWRITE_PROJECT_ID=your-project-id

# Privileged API key — tooling only (CLI/MCP/setup scripts).
# Never expose in frontend code. Create dev keys in:
# Appwrite Console > your project > Keys
APPWRITE_API_KEY=standard_your-api-key

# Database identifiers (fill in when a database is created)
APPWRITE_DATABASE_ID=
